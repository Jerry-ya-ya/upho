{
  "version": 1,
  "projects": {
    "reference": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "outputPath": "dist",
            "styles": [
              "src/styles.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "src/pages",
                "output": "content/pages",
                "ignore": [
                  "**/*.ts",
                  "**/*.component.html",
                  "**/*.component.css"
                ]
              },
              {
                "glob": "**/*.js",
                "input": "src/modules",
                "output": "content/modules"
              },
              {
                "glob": "theme.css",
                "input": "src/modules/theme",
                "output": "content/modules/theme"
              },
              {
                "glob": "*.json",
                "input": "src/i18n",
                "output": "content/i18n"
              }
            ],
            "outputHashing": "all"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "reference:build"
          }
        }
      }
    }
  }
}
